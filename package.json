{
  "name": "stickflip",
  "version": "0.1.0",
  "private": true,
  "description": "Tap-to-play stick figure skateboarding game. Seven stages of named checkpoints and a secret Mega Ramp.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "icons": "node scripts/make-icons.mjs",
    "ios": "node scripts/build-app.mjs && cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
